# ==============================================================================
# BATTLE GROUND — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# CATATAN KEAMANAN:
# - File ini HANYA memuat nama variabel yang benar-benar digunakan oleh sistem.
# - Dilarang keras menaruh token asli, private key, atau database credential di sini.
# - Salin file ini menjadi .env untuk penggunaan lokal: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Express Backend Configuration (apps/server)
# ------------------------------------------------------------------------------
# Port tempat Express server mendengarkan koneksi masuk
PORT=4000

# Lingkungan runtime: 'development', 'test', atau 'production'
NODE_ENV=development

# Domain/Origin yang diizinkan untuk CORS (contoh: '*' untuk dev lokal, atau 'https://domain-kamu.com')
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. Mobile Expo Client Configuration (apps/mobile)
# ------------------------------------------------------------------------------
# API Base URL yang dipanggil oleh mobile client.
# PERHATIAN:
# - iOS Simulator: gunakan http://localhost:4000
# - Android Emulator: gunakan http://10.0.2.2:4000 (10.0.2.2 adalah gateway host loopback)
# - Perangkat Fisik (Expo Go): gunakan IP LAN komputer Anda (contoh: http://192.168.1.50:4000)
#
# JANGAN PERNAH menaruh secret backend pada variabel EXPO_PUBLIC_* karena
# nilai ini dapat diekstraksi dari bundle klien.
EXPO_PUBLIC_API_URL=http://localhost:4000

