{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScoreUpdate",
  "description": "Event broadcast when player score or kills update",
  "type": "object",
  "required": ["playerId", "kills", "deaths", "score"],
  "properties": {
    "playerId": {
      "type": "string"
    },
    "kills": {
      "type": "integer",
      "minimum": 0
    },
    "deaths": {
      "type": "integer",
      "minimum": 0
    },
    "score": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "number"
    }
  },
  "additionalProperties": false
}

